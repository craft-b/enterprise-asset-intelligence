# .env.example — Enterprise Asset Intelligence
# Copy to .env and fill in real values before running docker-compose.
# NEVER commit .env to git. This file is safe to commit.

# ── Database ─────────────────────────────────────────────────────────────────
# Full DSN used by Node/Drizzle. Must match the DB_* vars below.
DATABASE_URL=mysql://user:password@host:3306/enterprise_assets

# Individual vars used by the Python ML service (SQLAlchemy).
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=enterprise_assets

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Required: at least 32 chars. The placeholder below is rejected at boot --
# with NODE_ENV=production the server refuses to start until it is replaced.
SESSION_SECRET=replace-with-64-char-random-hex

# ── ML Service ────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant
# LLM maintenance recommendations are opt-in. off = deterministic template only
# (batch scoring always uses the template regardless of this flag).
GENAI_RECOMMENDATIONS=off

# Swagger UI / ReDoc / openapi.json. Off by default: they must bypass the
# service-token check to work, so on a reachable deployment they publish the
# whole API surface. On for local development.
ENABLE_API_DOCS=true

# MLflow tracking server URI. If unset, MLflow logging is skipped (safe no-op).
MLFLOW_TRACKING_URI=

# Incoming webhook URL for monitor.py Slack alerts. If unset, notifications are silently skipped.
SLACK_WEBHOOK_URL=

# Set to utf-8 on Windows to avoid codec errors in monitor.py / training scripts.
PYTHONIOENCODING=utf-8

# ── Agent API ─────────────────────────────────────────────────────────────────
# Bearer token for programmatic / LLM agent access to /api/agent/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_API_KEY=replace-with-64-char-random-hex

# SEC-1: shared token authenticating Node <-> ML service (any 64-char hex)
ML_SERVICE_TOKEN=replace-with-64-char-random-hex
