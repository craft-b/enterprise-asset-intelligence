# .env.example — Enterprise Asset Intelligence
# Copy to .env and fill in real values before running docker-compose.
# NEVER commit .env to git. This file is safe to commit.

# ── Database ─────────────────────────────────────────────────────────────────
# Full DSN used by Node/Drizzle. Must match the DB_* vars below.
DATABASE_URL=mysql://user:password@host:3306/enterprise_assets

# Individual vars used by the Python ML service (SQLAlchemy).
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=enterprise_assets

# ── Auth ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API from a browser with
# cookies. Only needed when the SPA is hosted separately (static host +
# container API). A wildcard is refused at boot: browsers reject
# Allow-Origin:* alongside Allow-Credentials.
# ALLOWED_ORIGINS=https://your-project.vercel.app

# Generate with: openssl rand -hex 32
# Required: at least 32 chars. The placeholder below is rejected at boot --
# with NODE_ENV=production the server refuses to start until it is replaced.
SESSION_SECRET=replace-with-64-char-random-hex

# ── ML Service ────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant
# LLM maintenance recommendations are opt-in. off = deterministic template only
# (batch scoring always uses the template regardless of this flag).
GENAI_RECOMMENDATIONS=off

# Swagger UI / ReDoc / openapi.json. Off by default: they must bypass the
# service-token check to work, so on a reachable deployment they publish the
# whole API surface. On for local development.
ENABLE_API_DOCS=true

# MLflow tracking server URI. If unset, MLflow logging is skipped (safe no-op).
MLFLOW_TRACKING_URI=

# Incoming webhook URL for monitor.py Slack alerts. If unset, notifications are silently skipped.
SLACK_WEBHOOK_URL=

# Set to utf-8 on Windows to avoid codec errors in monitor.py / training scripts.
PYTHONIOENCODING=utf-8

# Seeds the admin/viewer accounts the login page names. Off by default:
# published credentials on an account that can modify data are right for a
# public demo of synthetic data and wrong for anything else.
# SEED_DEMO_USERS=true

# ── Frontend build ──────────────────────────────────────────────────
# Read by Vite and baked into the bundle at BUILD time, not runtime.
# Leave unset when the API serves the SPA from the same origin (npm run dev,
# docker-compose). Set it to the API origin when the frontend is hosted
# separately, and rebuild after changing it. No trailing slash.
# VITE_API_URL=https://eai-api.onrender.com

# ── Agent API ─────────────────────────────────────────────────────────────────
# Bearer token for programmatic / LLM agent access to /api/agent/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_API_KEY=replace-with-64-char-random-hex

# SEC-1: shared token authenticating Node <-> ML service (any 64-char hex)
ML_SERVICE_TOKEN=replace-with-64-char-random-hex

# URL of the FastAPI ML service. Unset means the Node API answers ML-backed
# endpoints with a clear "not configured" rather than guessing at localhost.
ML_SERVICE_URL=http://localhost:8000

# Pins the date the demo seed treats as "today" (YYYY-MM-DD). Unset means the
# real current date, which is what you want: the fleet's ages, maintenance
# history and risk horizons are all derived from it, so a stale pin is how a
# demo ends up showing equipment serviced in the future.
# SEED_CURSOR_DATE=

# ── Testing ───────────────────────────────────────────────────────────────────
# A second database the test suite is allowed to write to. The write-path tests
# create and delete rentals, equipment and job sites, so they refuse to run
# against anything whose database name does not contain "test" -- and skip
# entirely when this is unset, so `npm test` still works in a clean checkout.
# Create it alongside the main one and apply the schema with:
#   DATABASE_URL=$TEST_DATABASE_URL npm run db:push
# TEST_DATABASE_URL=mysql://user:password@host:3306/enterprise_assets_test

# Enables POST /api/test-login, which issues a session for an EXISTING user id
# without a password, for the HTTP tests. Refused outright when
# NODE_ENV=production, and when this is shorter than 24 characters. Never set
# it on a deployed environment.
# TEST_LOGIN_SECRET=
