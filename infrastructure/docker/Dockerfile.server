# Dockerfile.server — Node.js API gateway
# Multi-stage: builds both Vite client and esbuild server bundle,
# then runs the compiled server which also serves the React SPA in production.

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install all deps (dev deps needed for build tooling)
COPY package*.json ./
RUN npm ci --ignore-scripts

# Copy full source
COPY . .

# Build: runs vite (client → dist/public/) + esbuild (server → dist/index.cjs)
RUN npm run build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Copy built artifacts
COPY --from=builder /app/dist ./dist

# Copy production node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# ml-service/registry is deliberately NOT copied.
#
# It used to be, "needed by routes.ts to read feature importance files". That
# stopped being true: feature importance comes over HTTP from the ML service
# (mlFetch("/models/feature-importance")), and the last filesystem read of
# this directory -- the modelStatus probe -- was removed in 4342e72 because it
# could only ever fail here. The API and the ML service are separate images;
# this path has only ever existed in the other one.
#
# Verified before removing: the compiled bundle contains no reference to
# ml-service/registry or any ml-service path, and the only fs call in server/
# is static.ts checking dist/. See scripts/dockerfile-parity.test.ts.
#
# Not free to carry. From a git clone it is ~1.7MB of superseded JSON, since
# registry/*.pkl is gitignored -- but .dockerignore does not exclude those, so
# a build from a working tree that has trained locally copies every pickle in
# it: 431MB measured, none of it read.

# drizzle-kit migrate reads the config, the migration files and the schema
# they point at, so all three have to be in the RUNTIME image -- not just the
# build stage. This image had none of them and no entrypoint either, so the
# migrations docker-compose.yml promises on boot were never applied and the
# server came up against a database with no tables. The root Dockerfile, which
# is the image actually running in production, has had this right all along;
# this one had silently diverged from it. See dockerfile-parity.test.ts.
# Mirrors the production image: the two registry JSON families the model page
# falls back to when the ML service cannot be reached. Scoped to these globs so
# no *.pkl can match. See Dockerfile and services/model-card.ts.
COPY --from=builder /app/ml-service/registry/metadata_30d_*.json      /app/ml-service/registry/feature_importance_30d_*.json      ./ml-service/registry/

COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/drizzle.config.ts ./
COPY --from=builder /app/tsconfig.json ./

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV NODE_ENV=production

EXPOSE 5000

# The entrypoint applies migrations and then execs the server. Setting CMD as
# well would be dead configuration: ENTRYPOINT ignores it here.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
